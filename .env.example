# Local development only. Compose uses disposable example database credentials.
# Copy to .env only to override these defaults. Never commit real credentials.
WEB_PORT=8080
DATABASE_PORT=54329
# For `npm run dev`, use http://localhost:5173 instead.
APP_ORIGIN=http://localhost:8080
PORT=3000

# Node development/migration connections (Compose containers set their own internal URLs).
DATABASE_URL=postgresql://gs_app:local-app-only@127.0.0.1:54329/greenstate
ADMIN_DATABASE_URL=postgresql://gs_admin:local-admin-only@127.0.0.1:54329/greenstate
MIGRATION_DATABASE_URL=postgresql://gs_owner:local-owner-only@127.0.0.1:54329/greenstate
TEST_DATABASE_SERVER_URL=postgresql://postgres:local-postgres-only@127.0.0.1:54329/postgres

# Compose explicitly enables challenge demo data; source CLI defaults to skipping it.
SEED_DEMO_DATA=true

# Direct Node development trusts no proxy. Compose sets one hop behind nginx,
# which overwrites forwarded client addresses. Do not enable this on a directly exposed API.
TRUST_PROXY_HOPS=0
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_REGISTRATION_IP_LIMIT=10
AUTH_PASSWORD_ACTOR_LIMIT=10
AUTH_WINDOW_MS=900000
AUTH_MAX_BUCKETS=10000
